  "root": "ticket-board",
  "elements": {
    "ticket-board": {
      "type": "Kanban",
      "name": "ticket-board",
      "data": "$data.tickets",
      "rowIdField": "id",
      "stages": "$data.stages",
      "groupBy": "stage",
      "cardDensity": "compact",
      "columnWidth": 320,
      "countDisplay": "tag",
      "filterInlineLimit": 2,
      "maxCardsPerColumn": 12,
      "stageControl": "menu",
      "labels": { "moveTo": "Move" },
      "metrics": "$data.boardMetrics",
      "recordLabel": { "singular": "ticket", "plural": "tickets" },
      "searchFields": ["subject", "customer", "company", "id"],
      "fuzzySearch": true,
      "showFilterBadges": true,
      "showClearFiltersButton": true,
      "selectable": true,
      "selectionActions": [
        {
          "label": "Reassign",
          "icon": "user",
          "variant": "secondary",
          "onClick": {
            "$action": "addAlert",
            "type": "info",
            "title": "Reassign",
            "message": "Would open the owner picker for the selected tickets."
          }
        },
        {
          "label": "Escalate to Tier-2",
          "icon": "alert",
          "variant": "secondary",
          "onClick": {
            "$action": "addAlert",
            "type": "warning",
            "title": "Escalated",
            "message": "Tier-2 paged for the selected tickets."
          }
        },
        {
          "label": "Snooze 24h",
          "icon": "clock",
          "variant": "secondary",
          "onClick": {
            "$action": "addAlert",
            "type": "success",
            "title": "Snoozed",
            "message": "Selected tickets hidden for 24h."
          }
        }
      ],
      "filters": [
        {
          "name": "assignee",
          "type": "multiselect",
          "placeholder": "All assignees",
          "chipLabel": "Assignee",
          "options": "$data.assigneeOptions"
        },
        {
          "name": "priorityLabel",
          "type": "multiselect",
          "placeholder": "All priorities",
          "chipLabel": "Priority",
          "options": "$data.priorityOptions"
        }
      ],
      "onStageChange": {
        "$action": "addAlert",
        "type": "success",
        "title": "Stage updated",
        "message": "Ticket moved. Customers are auto-notified for resolved/closed transitions."
      },
      "cardFields": [
        {
          "field": "subject",
          "placement": "title",
          "render": {
            "$render": ["value", "row"],
            "node": {
              "type": "Link",
              "onClick": {
                "$action": "addAlert",
                "type": "info",
                "title": "Open ticket",
                "message": "Would navigate to {{row.id}}."
              },
              "children": "$value"
            }
          }
        },
        {
          "field": "priorityLabel",
          "placement": "body",
          "label": "Priority",
          "render": {
            "$render": ["value", "row"],
            "node": {
              "type": "StatusTag",
              "variant": "$row.priorityVariant",
              "children": "$value"
            }
          }
        },
        {
          "field": "customer",
          "placement": "body",
          "label": "Customer",
          "render": {
            "$render": ["value", "row"],
            "node": {
              "type": "Text",
              "children": "{{value}} · {{row.company}}"
            }
          }
        },
        {
          "field": "assignee",
          "placement": "body",
          "label": "Assigned to"
        },
        {
          "field": "ageLabel",
          "placement": "body",
          "label": "Age"
        },
        {
          "key": "actions",
          "placement": "footer",
          "render": {
            "$render": ["value", "row"],
            "node": {
              "type": "KanbanCardActions",
              "display": "icon",
              "actions": [
                {
                  "key": "comment",
                  "label": "Add note",
                  "icon": "comment",
                  "onClick": {
                    "$action": "addAlert",
                    "type": "info",
                    "title": "Add note",
                    "message": "Would open the note composer for {{row.id}}."
                  }
                },
                {
                  "key": "email",
                  "label": "Reply to customer",
                  "icon": "email",
                  "onClick": {
                    "$action": "addAlert",
                    "type": "info",
                    "title": "Reply",
                    "message": "Would open the email composer for {{row.id}}."
                  }
                },
                {
                  "key": "task",
                  "label": "Create follow-up task",
                  "icon": "tasks",
                  "onClick": {
                    "$action": "addAlert",
                    "type": "info",
                    "title": "Task",
                    "message": "Would open the task composer for {{row.id}}."
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
