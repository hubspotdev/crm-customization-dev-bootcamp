{
  "meta": {
    "name": "Property Showings",
    "tagline": "Property identity above a searchable, filterable showings table with inline feedback-logging panels.",
    "description": "Lets a listing agent manage showings for a property from the deal record: who's coming, who toured already, and who left strong interest. Completed showings expose a panel to log feedback in one click. \u2014 List Manager: DescriptionList of property details + DataTable with search/filter/sort + inline feedback Panel.",
    "surface": "crm.record.tab",
    "object": "deal"
  },
  "state": {
    "viewMode": "loaded"
  },
