  },
  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "layout": "centered"
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Unable to load showings",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": "There was a problem retrieving the showing schedule for this property. Please try again in a few moments."
    },
    "empty-deal-name-text": {
      "type": "Text",
      "children": "$data.deal.dealname"
    },
    "empty-deal-name-item": {
      "type": "DescriptionListItem",
      "label": "Property",
      "children": [
        "empty-deal-name-text"
      ]
    },
    "empty-deal-stage-text": {
      "type": "Text",
      "children": "$data.deal.dealstage"
    },
    "empty-deal-stage-item": {
      "type": "DescriptionListItem",
      "label": "Stage",
      "children": [
        "empty-deal-stage-text"
      ]
    },
    "empty-deal-amount-text": {
      "type": "Text",
      "children": "$data.deal.amount"
    },
    "empty-deal-amount-item": {
      "type": "DescriptionListItem",
      "label": "List Price",
      "children": [
        "empty-deal-amount-text"
      ]
    },
    "empty-identity": {
      "type": "DescriptionList",
      "direction": "row",
      "children": [
        "empty-deal-name-item",
        "empty-deal-stage-item",
        "empty-deal-amount-item"
      ]
    },
    "empty-divider": {
      "type": "Divider"
    },
    "empty-body-text": {
      "type": "Text",
      "children": "No showing appointments have been created for this property yet. Schedule the first showing to start tracking buyer interest."
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No showings scheduled",
      "layout": "vertical",
      "children": [
        "empty-body-text"
      ]
    },
    "empty-state": {
      "type": "Flex",
      "name": "empty-state",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "empty-identity",
        "empty-divider",
        "emptystate"
      ]
    },
    "address-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.property.address"
    },
    "address-item": {
      "type": "DescriptionListItem",
      "label": "Address",
      "children": [
        "address-text"
      ]
    },
    "list-price-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.property.listPrice"
    },
    "list-price-item": {
      "type": "DescriptionListItem",
      "label": "List price",
      "children": [
        "list-price-text"
      ]
    },
    "mls-text": {
      "type": "Text",
      "children": "$data.property.mlsNumber"
    },
    "mls-item": {
      "type": "DescriptionListItem",
      "label": "MLS #",
      "children": [
        "mls-text"
      ]
    },
    "listing-agent-text": {
      "type": "Text",
      "children": "$data.property.listingAgent"
    },
    "listing-agent-item": {
      "type": "DescriptionListItem",
      "label": "Listing agent",
      "children": [
        "listing-agent-text"
      ]
    },
    "dom-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.property.daysOnMarket"
    },
    "dom-item": {
      "type": "DescriptionListItem",
      "label": "Days on market",
      "children": [
        "dom-text"
      ]
    },
    "property-details": {
      "type": "DescriptionList",
      "name": "property-details",
      "direction": "row",
      "children": [
        "address-item",
        "list-price-item",
        "mls-item",
        "listing-agent-item",
        "dom-item"
      ]
    },
    "section-header-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "Showing schedule"
    },
    "schedule-showing-button": {
      "type": "Button",
      "variant": "primary",
      "children": "Schedule showing"
    },
    "section-header": {
      "type": "Flex",
      "name": "section-header",
      "direction": "row",
      "justify": "between",
      "align": "center",
      "children": [
        "section-header-text",
        "schedule-showing-button"
      ]
    },
    "showings-table": {
      "type": "DataTable",
      "name": "showings-table",
      "data": "$data.showings",
      "searchFields": [
        "buyerName",
        "agentName"
      ],
      "searchPlaceholder": "Search by buyer or agent...",
      "pageSize": 10,
      "defaultSort": {
        "dateTime": "descending"
      },
      "filters": [
        {
          "type": "select",
          "name": "status",
          "placeholder": "All statuses",
          "options": "$data.statusFilterOptions"
        }
      ],
      "columns": [
        {
          "field": "buyerName",
          "label": "Buyer",
          "width": "auto",
          "sortable": true,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Flex",
              "direction": "column",
              "children": [
                {
                  "type": "Link",
                  "visible": "$row.isClickableBuyer",
                  "overlay": {
                    "type": "Panel",
                    "id": "feedback-panel-{{row.id}}",
                    "title": "$row.feedbackPanelTitle",
                    "width": "small",
                    "variant": "modal",
                    "flush": true,
                    "children": [
                      {
                        "type": "PanelBody",
                        "children": [
                          {
                            "type": "PanelSection",
                            "children": [
                              {
                                "type": "Flex",
                                "direction": "column",
                                "gap": "sm",
                                "children": [
                                  {
                                    "type": "DescriptionList",
                                    "direction": "row",
                                    "children": [
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Buyer",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.buyerName"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Agent",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.agentName"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Date",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.dateTimeLabel"
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "type": "Divider"
                                  },
                                  {
                                    "type": "Select",
                                    "label": "Interest level",
                                    "name": "feedback-interest",
                                    "required": true,
                                    "placeholder": "Select interest level",
                                    "value": "$row.feedbackInterest",
                                    "options": "$data.interestOptions"
                                  },
                                  {
                                    "type": "ToggleGroup",
                                    "label": "Follow-up requested?",
                                    "name": "feedback-followup",
                                    "toggleType": "radioButtonList",
                                    "inline": true,
                                    "value": "$row.feedbackFollowUp",
                                    "options": "$data.followUpOptions"
                                  },
                                  {
                                    "type": "TextArea",
                                    "label": "Agent notes",
                                    "name": "feedback-notes",
                                    "placeholder": "How did the showing go? Any specific concerns or highlights...",
                                    "value": "$row.feedbackNotes",
                                    "resize": "vertical",
                                    "rows": 4
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "PanelFooter",
                        "children": [
                          {
                            "type": "Flex",
                            "direction": "column",
                            "children": [
                              {
                                "type": "Flex",
                                "direction": "row",
                                "justify": "between",
                                "children": [
                                  {
                                    "type": "Button",
                                    "variant": "secondary",
                                    "onClick": {
                                      "$action": "closeOverlay",
                                      "id": "feedback-panel-{{row.id}}"
                                    },
                                    "children": "Cancel"
                                  },
                                  {
                                    "type": "LoadingButton",
                                    "variant": "primary",
                                    "children": "Save feedback"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "children": [
                    {
                      "type": "Text",
                      "format": {
                        "fontWeight": "demibold"
                      },
                      "truncate": true,
                      "children": "$value"
                    }
                  ]
                },
                {
                  "type": "Text",
                  "visible": {
                    "$eq": [
                      "$row.isClickableBuyer",
                      false
                    ]
                  },
                  "format": {
                    "fontWeight": "demibold"
                  },
                  "truncate": true,
                  "children": "$value"
                }
              ]
            }
          }
        },
        {
          "field": "agentName",
          "label": "Buyer's Agent",
          "width": "min",
          "sortable": true
        },
        {
          "field": "status",
          "label": "Status",
          "width": "min",
          "sortable": true,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "variant": "$row.statusVariant",
              "children": "$row.statusLabel"
            }
          }
        },
        {
          "field": "followUp",
          "label": "Follow-up",
          "width": "min",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Flex",
              "direction": "column",
              "children": [
                {
                  "type": "Button",
                  "visible": "$row.showLogFeedbackButton",
                  "size": "extra-small",
                  "variant": "secondary",
                  "overlay": {
                    "type": "Panel",
                    "id": "feedback-panel-{{row.id}}",
                    "title": "$row.feedbackPanelTitle",
                    "width": "small",
                    "variant": "modal",
                    "flush": true,
                    "children": [
                      {
                        "type": "PanelBody",
                        "children": [
                          {
                            "type": "PanelSection",
                            "children": [
                              {
                                "type": "Flex",
                                "direction": "column",
                                "gap": "sm",
                                "children": [
                                  {
                                    "type": "DescriptionList",
                                    "direction": "row",
                                    "children": [
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Buyer",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.buyerName"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Agent",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.agentName"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Date",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.dateTimeLabel"
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "type": "Divider"
                                  },
                                  {
                                    "type": "Select",
                                    "label": "Interest level",
                                    "name": "feedback-interest",
                                    "required": true,
                                    "placeholder": "Select interest level",
                                    "options": "$data.interestOptions"
                                  },
                                  {
                                    "type": "ToggleGroup",
                                    "label": "Follow-up requested?",
                                    "name": "feedback-followup",
                                    "toggleType": "radioButtonList",
                                    "inline": true,
                                    "options": "$data.followUpOptions"
                                  },
                                  {
                                    "type": "TextArea",
                                    "label": "Agent notes",
                                    "name": "feedback-notes",
                                    "placeholder": "How did the showing go? Any specific concerns or highlights...",
                                    "resize": "vertical",
                                    "rows": 4
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "PanelFooter",
                        "children": [
                          {
                            "type": "Flex",
                            "direction": "column",
                            "children": [
                              {
                                "type": "Flex",
                                "direction": "row",
                                "justify": "between",
                                "children": [
                                  {
                                    "type": "Button",
                                    "variant": "secondary",
                                    "onClick": {
                                      "$action": "closeOverlay",
                                      "id": "feedback-panel-{{row.id}}"
                                    },
                                    "children": "Cancel"
                                  },
                                  {
                                    "type": "LoadingButton",
                                    "variant": "primary",
                                    "children": "Save feedback"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "children": "Log feedback"
                },
                {
                  "type": "Text",
                  "visible": {
                    "$eq": [
                      "$row.showLogFeedbackButton",
                      false
                    ]
                  },
                  "children": "$row.followUpLabel"
                }
              ]
            }
          }
        },
        {
          "field": "dateTime",
          "label": "Date / Time",
          "width": "min",
          "sortable": true,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Text",
              "children": "$row.dateTimeLabel"
            }
          }
        }
      ],
      "emptyTitle": "No results found",
      "emptyMessage": "No showings match your search or filter criteria."
    },
    "loaded-content": {
      "type": "Flex",
      "name": "loaded-content",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loaded"
        ]
      },
      "children": [
        "property-details",
        "section-header",
        "showings-table"
      ]
    },
    "card-root": {
      "type": "Flex",
      "name": "card-root",
      "direction": "column",
      "gap": "sm",
      "children": [
        "loading-state",
        "alert",
        "empty-state",
        "loaded-content"
      ]
    }
  }
}