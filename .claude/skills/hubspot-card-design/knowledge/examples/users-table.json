{
  "meta": {
    "name": "Users Table",
    "tagline": "HubSpot users in one table with search, filters, and per-row edit.",
    "description": "Lists HubSpot users in a single searchable, filterable table \u2014 an easy way to find, compare, and edit a user without navigating through settings. Per-row edit opens inline without a page change. \u2014 List Manager: DataTable with search, filters, and per-row edit Modal.",
    "surface": "crm.record.tab",
    "object": "contact"
  },
  "state": {
    "viewMode": "loaded"
  },
  "data": {
    "users": [
      {
        "id": "u1",
        "name": "Sarah Chen",
        "email": "sarah.chen@acme.com",
