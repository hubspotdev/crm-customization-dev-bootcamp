  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "label": "Loading vehicle data...",
      "showLabel": true,
      "layout": "centered"
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Unable to load maintenance data",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": "Something went wrong while fetching vehicle records. Please try again in a few moments."
    },
    "text": {
      "type": "Text",
      "children": "This vehicle has no logged maintenance events yet. Log the first service to start tracking."
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No maintenance records",
      "layout": "vertical",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "text"
      ]
    },
    "text-1": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vehicle.displayName"
    },
    "descriptionlistitem": {
      "type": "DescriptionListItem",
      "label": "Vehicle",
      "children": [
        "text-1"
      ]
    },
    "text-2": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vehicle.currentMileage"
    },
    "descriptionlistitem-1": {
      "type": "DescriptionListItem",
      "label": "Current mileage",
      "children": [
        "text-2"
      ]
    },
    "text-3": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vehicle.vin"
    },
    "descriptionlistitem-2": {
      "type": "DescriptionListItem",
      "label": "VIN",
      "children": [
        "text-3"
      ]
    },
    "text-4": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vehicle.licensePlate"
    },
    "descriptionlistitem-3": {
      "type": "DescriptionListItem",
      "label": "License plate",
      "children": [
        "text-4"
      ]
    },
    "text-5": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vehicle.assignedDriver"
    },
    "descriptionlistitem-4": {
      "type": "DescriptionListItem",
      "label": "Assigned driver",
      "children": [
        "text-5"
      ]
    },
    "text-6": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vehicle.fleetRegion"
    },
    "descriptionlistitem-5": {
      "type": "DescriptionListItem",
      "label": "Fleet region",
      "children": [
        "text-6"
      ]
    },
    "text-7": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vehicle.nextServiceDate"
    },
    "descriptionlistitem-6": {
      "type": "DescriptionListItem",
      "label": "Next service",
      "children": [
        "text-7"
      ]
    },
    "vehicle-identity": {
      "type": "DescriptionList",
      "name": "vehicle-identity",
      "direction": "row",
      "children": [
        "descriptionlistitem",
        "descriptionlistitem-1",
        "descriptionlistitem-2",
        "descriptionlistitem-3",
        "descriptionlistitem-4",
        "descriptionlistitem-5",
        "descriptionlistitem-6"
      ]
    },
    "service-status-alert": {
      "type": "Alert",
      "name": "service-status-alert",
      "variant": "$data.serviceAlert.variant",
      "title": "$data.serviceAlert.title",
      "children": "$data.serviceAlert.body"
    },
    "divider": {
      "type": "Divider"
    },
    "text-8": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "Maintenance log"
    },
    "button": {
      "type": "Button",
      "variant": "primary",
      "overlay": {
        "type": "Panel",
        "id": "log-service-panel",
        "title": "Log maintenance service",
        "width": "small",
        "variant": "modal",
        "flush": true,
        "children": [
          {
            "type": "PanelBody",
            "children": [
              {
                "type": "PanelSection",
                "children": [
                  {
                    "type": "Flex",
                    "direction": "column",
                    "gap": "sm",
                    "children": [
                      {
                        "type": "DateInput",
                        "label": "Service date",
                        "required": true,
                        "format": "medium",
                        "todayButtonLabel": "Today"
                      },
                      {
                        "type": "Select",
                        "label": "Service type",
                        "required": true,
                        "placeholder": "Select a service type",
                        "options": "$data.serviceTypeFormOptions"
                      },
                      {
                        "type": "Input",
                        "label": "Shop / provider",
                        "required": true,
                        "placeholder": "e.g. Jiffy Lube \u2014 Springfield"
                      },
                      {
                        "type": "NumberInput",
                        "label": "Cost ($)",
                        "placeholder": "0.00",
                        "min": 0,
                        "precision": 2
                      },
                      {
                        "type": "NumberInput",
                        "label": "Mileage at service",
                        "placeholder": "e.g. 67500",
                        "min": 0
                      },
                      {
                        "type": "TextArea",
                        "label": "Notes",
                        "placeholder": "What was done? Any findings or recommendations?",
                        "resize": "vertical",
                        "rows": 3
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "PanelFooter",
            "children": [
              {
                "type": "Flex",
                "direction": "row",
                "justify": "between",
                "children": [
                  {
                    "type": "Button",
                    "variant": "secondary",
                    "onClick": {
                      "$action": "closeOverlay",
                      "id": "log-service-panel"
                    },
                    "children": "Cancel"
                  },
                  {
                    "type": "LoadingButton",
                    "variant": "primary",
                    "children": "Save record"
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": "Log service"
    },
    "log-header": {
      "type": "Flex",
      "name": "log-header",
      "direction": "row",
      "justify": "between",
      "align": "center",
      "children": [
        "text-8",
        "button"
      ]
    },
    "maintenance-table": {
      "type": "DataTable",
      "name": "maintenance-table",
      "data": "$data.records",
      "searchFields": [
        "serviceType",
        "shop"
      ],
      "pageSize": 8,
      "defaultSort": {
        "date": "descending"
      },
      "rowCountText": {
        "$render": [
          "shown",
          "total"
        ],
        "node": "{{total}} records"
      },
      "filters": [
        {
          "type": "select",
          "name": "serviceType",
          "placeholder": "All types",
          "options": "$data.typeFilterOptions"
        }
      ],
      "columns": [
        {
          "field": "date",
          "label": "Date",
          "sortable": true,
          "footer": "Total"
        },
        {
          "field": "serviceType",
          "label": "Type",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "variant": "$row.tagVariant",
              "children": "$value"
            }
          }
        },
        {
          "field": "shop",
          "label": "Shop",
          "sortable": true
        },
        {
          "field": "cost",
          "label": "Cost",
          "sortable": true,
          "align": "right",
          "footer": "$data.totalSpendLabel",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Text",
              "format": {
                "fontWeight": "demibold"
              },
              "children": "$row.costLabel"
            }
          }
        },
        {
          "field": "mileageLabel",
          "label": "Mileage",
          "align": "right"
        }
      ]
    },
    "loaded-content": {
      "type": "Flex",
      "name": "loaded-content",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loaded"
        ]
      },
      "children": [
        "vehicle-identity",
        "service-status-alert",
        "divider",
        "log-header",
        "maintenance-table"
      ]
    },
    "card-root": {
      "type": "Flex",
      "name": "card-root",
      "direction": "column",
      "gap": "sm",
      "children": [
        "loading-state",
        "alert",
        "emptystate",
        "loaded-content"
      ]
    }
  }
}