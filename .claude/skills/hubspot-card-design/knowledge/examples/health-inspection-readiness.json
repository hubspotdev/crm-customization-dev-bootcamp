  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "label": "Loading inspection data...",
      "layout": "centered",
      "showLabel": true
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "error-alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Unable to load inspection data",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": "There was a problem retrieving the health inspection checklist. Please try again or contact your administrator."
    },
    "restaurant-name-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.restaurant.name"
    },
    "restaurant-name-item": {
      "type": "DescriptionListItem",
      "label": "Restaurant",
      "children": [
        "restaurant-name-text"
      ]
    },
    "restaurant-location-text": {
      "type": "Text",
      "children": "$data.restaurant.location"
    },
    "restaurant-location-item": {
      "type": "DescriptionListItem",
      "label": "Location",
      "children": [
        "restaurant-location-text"
      ]
    },
    "restaurant-manager-text": {
      "type": "Text",
      "children": "$data.restaurant.manager"
    },
    "restaurant-manager-item": {
      "type": "DescriptionListItem",
      "label": "Manager",
      "children": [
        "restaurant-manager-text"
      ]
    },
    "restaurant-lastinspection-text": {
      "type": "Text",
      "children": "$data.restaurant.lastInspection"
    },
    "restaurant-lastinspection-item": {
      "type": "DescriptionListItem",
      "label": "Last inspection",
      "children": [
        "restaurant-lastinspection-text"
      ]
    },
    "restaurant-header": {
      "type": "DescriptionList",
      "name": "restaurant-header",
      "direction": "row",
      "children": [
        "restaurant-name-item",
        "restaurant-location-item",
        "restaurant-manager-item",
        "restaurant-lastinspection-item"
      ]
    },
    "empty-divider": {
      "type": "Divider",
      "size": "medium"
    },
    "empty-body-text": {
      "type": "Text",
      "children": "No health inspection checklist has been configured for this restaurant. Create a checklist to start tracking readiness."
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No inspection checklist",
      "layout": "vertical",
      "children": [
        "empty-body-text"
      ]
    },
    "empty-state": {
      "type": "Flex",
      "name": "empty-state",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "restaurant-header",
        "empty-divider",
        "emptystate"
      ]
    },
    "failing-alert": {
      "type": "Alert",
      "name": "failing-alert",
      "variant": "error",
      "title": "$data.alertTitle",
      "visible": "$data.alertVisible",
      "children": "$data.alertMessage"
    },
    "overall-progress": {
      "type": "ProgressBar",
      "name": "overall-progress",
      "title": "Overall readiness",
      "value": "$data.overallScore",
      "maxValue": 100,
      "showPercentage": true,
      "valueDescription": "$data.overallValueDescription",
      "variant": "$data.overallScoreVariant"
    },
    "loaded-divider": {
      "type": "Divider",
      "size": "medium"
    },
    "categories-grid": {
      "type": "AutoGrid",
      "name": "categories-grid",
      "columnWidth": 350,
      "flexible": true,
      "gap": "small",
      "children": [
        {
          "$forEach": "$data.categories",
          "as": "category",
          "render": {
            "type": "Accordion",
            "title": "$category.name",
            "defaultOpen": "$category.needsAttention",
            "size": "sm",
            "children": [
              {
                "type": "Flex",
                "direction": "column",
                "gap": "flush",
                "children": [
                  {
                    "type": "Flex",
                    "direction": "row",
                    "align": "center",
                    "gap": "xs",
                    "children": [
                      {
                        "type": "Text",
                        "variant": "microcopy",
                        "children": "$category.categoryScoreLabel"
                      }
                    ]
                  },
                  {
                    "type": "Divider",
                    "size": "large"
                  },
                  {
                    "$forEach": "$category.items",
                    "as": "item",
                    "render": {
                      "type": "Flex",
                      "direction": "row",
                      "align": "center",
                      "gap": "xs",
                      "children": [
                        {
                          "type": "Icon",
                          "name": "$item.statusIcon",
                          "size": "sm"
                        },
                        {
                          "type": "Flex",
                          "direction": "column",
                          "gap": "flush",
                          "children": [
                            {
                              "type": "Flex",
                              "direction": "row",
                              "align": "center",
                              "gap": "xs",
                              "wrap": "nowrap",
                              "children": [
                                {
                                  "type": "Link",
                                  "overlay": {
                                    "type": "Panel",
                                    "id": "update-panel-{{item.id}}",
                                    "title": "Update: {{item.name}}",
                                    "width": "small",
                                    "flush": true,
                                    "variant": "modal",
                                    "children": [
                                      {
                                        "type": "PanelBody",
                                        "children": [
                                          {
                                            "type": "PanelSection",
                                            "children": [
                                              {
                                                "type": "Flex",
                                                "direction": "column",
                                                "gap": "sm",
                                                "children": [
                                                  {
                                                    "type": "Text",
                                                    "variant": "microcopy",
                                                    "children": "Category: {{category.name}}"
                                                  },
                                                  {
                                                    "type": "Select",
                                                    "label": "Inspection status",
                                                    "name": "status-{{item.id}}",
                                                    "required": true,
                                                    "value": "$item.status",
                                                    "options": "$data.statusOptions"
                                                  },
                                                  {
                                                    "type": "DateInput",
                                                    "label": "Last checked date",
                                                    "name": "date-{{item.id}}",
                                                    "format": "medium"
                                                  },
                                                  {
                                                    "type": "Flex",
                                                    "direction": "column",
                                                    "gap": "flush",
                                                    "visible": "$item.notesVisible",
                                                    "children": [
                                                      {
                                                        "type": "Text",
                                                        "variant": "microcopy",
                                                        "children": "Current notes"
                                                      },
                                                      {
                                                        "type": "Text",
                                                        "children": "$item.notes"
                                                      }
                                                    ]
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "type": "PanelFooter",
                                        "children": [
                                          {
                                            "type": "Flex",
                                            "direction": "column",
                                            "children": [
                                              {
                                                "type": "Flex",
                                                "direction": "row",
                                                "justify": "end",
                                                "children": [
                                                  {
                                                    "type": "LoadingButton",
                                                    "variant": "primary",
                                                    "children": "Save"
                                                  }
                                                ]
                                              }
                                            ]
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  "children": "$item.name"
                                },
                                {
                                  "type": "Tag",
                                  "variant": "$item.statusVariant",
                                  "children": "$item.statusLabel"
                                }
                              ]
                            },
                            {
                              "type": "Text",
                              "variant": "microcopy",
                              "visible": "$item.lastCheckedVisible",
                              "children": "$item.lastChecked"
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "loaded-content": {
      "type": "Flex",
      "name": "loaded-content",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loaded"
        ]
      },
      "children": [
        "restaurant-header",
        "failing-alert",
        "overall-progress",
        "loaded-divider",
        "categories-grid"
      ]
    },
    "card-root": {
      "type": "Flex",
      "name": "card-root",
      "direction": "column",
      "gap": "sm",
      "children": [
        "loading-state",
        "error-alert",
        "empty-state",
        "loaded-content"
      ]
    }
  }
}