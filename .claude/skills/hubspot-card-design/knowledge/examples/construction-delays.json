      },
      {
        "Date": "Mar 13",
        "Progress": 43.3,
        "Series": "Planned"
      },
      {
        "Date": "Mar 13",
        "Progress": 36.7,
        "Series": "Actual"
      },
      {
        "Date": "Mar 16",
        "Progress": 53.3,
        "Series": "Planned"
      },
      {
        "Date": "Mar 16",
        "Progress": 46.7,
        "Series": "Actual"
      },
      {
        "Date": "Mar 19",
        "Progress": 63.3,
        "Series": "Planned"
      },
      {
        "Date": "Mar 19",
        "Progress": 46.7,
        "Series": "Actual"
      },
      {
        "Date": "Mar 22",
        "Progress": 73.3,
        "Series": "Planned"
      },
      {
