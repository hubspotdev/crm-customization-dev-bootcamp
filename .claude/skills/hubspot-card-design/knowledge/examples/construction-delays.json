{
  "meta": {
    "name": "Construction Delays",
    "tagline": "Schedule slippage at a glance \u2014 delay causes, planned vs. actual progress, and per-cause detail.",
    "description": "Shows project managers exactly where a construction deal is slipping \u2014 planned vs. actual progress, which delay causes are driving it, and detail on each one. Clear enough to flag risk to a client or leadership without opening the full schedule. \u2014 Grouped Detail + Progress archetype: ProgressBar hero over an Accordion per delay cause.",
    "surface": "crm.record.tab",
    "object": "deal"
  },
  "state": {
    "viewMode": "loaded"
  },
  "data": {
    "viewModes": [
      {
        "value": "loaded",
        "label": "Loaded"
      },
      {
        "value": "loading",
        "label": "Loading"
      },
      {
        "value": "error",
        "label": "Error"
      },
      {
        "value": "empty",
        "label": "Empty"
      }
    ],
    "totalDelayDaysLabel": "7 days",
    "completionPercentLabel": "68%",
    "isDelayed": true,
    "trackingStatusLabel": "Behind schedule",
