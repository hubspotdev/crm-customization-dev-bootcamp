    "unassigned-table-wrap": {
      "type": "Flex",
      "name": "unassigned-table-wrap",
      "direction": "column",
      "gap": "flush",
      "children": [
        "unassigned-table"
      ]
    },
    "unassigned-accordion": {
      "type": "Accordion",
      "name": "unassigned-accordion",
      "title": "Needs Assignment (4)",
      "size": "sm",
      "defaultOpen": true,
      "children": [
        "unassigned-table-wrap"
      ]
    },
    "assigned-table": {
      "type": "DataTable",
      "name": "assigned-table",
      "data": "$data.assignedTickets",
      "searchFields": [
        "customer",
        "address",
        "zone",
        "assignedTech"
      ],
      "fuzzySearch": true,
      "pageSize": 10,
      "filters": [
        {
          "type": "multiselect",
          "name": "status",
          "placeholder": "All statuses",
          "options": "$data.statusOptions"
        },
        {
          "type": "multiselect",
          "name": "type",
          "placeholder": "All types",
          "options": "$data.typeOptions"
        }
      ],
      "columns": [
        {
          "field": "customer",
          "label": "Customer & Address",
          "sortable": false,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Flex",
              "direction": "column",
              "gap": "extra-small",
              "children": [
                {
                  "type": "Text",
                  "format": {
                    "fontWeight": "demibold"
                  },
                  "truncate": true,
                  "children": "$row.customer"
                },
                {
                  "type": "Text",
                  "variant": "microcopy",
                  "truncate": true,
                  "children": "$row.address"
                }
              ]
            }
          }
        },
        {
          "field": "type",
          "label": "Type",
          "sortable": false,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "variant": "default",
              "children": "$row.type"
            }
          }
        },
        {
          "field": "status",
          "label": "Status",
          "sortable": false,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "StatusTag",
              "variant": "$row.statusVariant",
              "children": "$row.statusLabel"
            }
          }
        },
        {
          "field": "scheduled",
          "label": "Scheduled",
          "sortable": false
        },
        {
          "field": "slaDue",
          "label": "SLA Due",
          "sortable": false
        },
        {
          "field": "zone",
          "label": "Zone",
          "sortable": false
        },
        {
          "field": "assignedTech",
          "label": "Assigned Tech",
          "sortable": false
        }
      ]
    },
    "assigned-table-wrap": {
      "type": "Flex",
      "name": "assigned-table-wrap",
      "direction": "column",
      "gap": "flush",
      "children": [
        "assigned-table"
      ]
    },
    "assigned-accordion": {
      "type": "Accordion",
      "name": "assigned-accordion",
      "title": "Assigned & En Route (3)",
      "size": "sm",
      "defaultOpen": false,
      "children": [
        "assigned-table-wrap"
      ]
    },
    "loaded-content": {
      "type": "Flex",
      "name": "loaded-content",
      "direction": "column",
      "gap": "md",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loaded"
        ]
      },
      "children": [
        "dispatch-kpis",
        "divider",
        "unassigned-accordion",
        "assigned-accordion"
      ]
    },
    "card-root": {
      "type": "Flex",
      "name": "card-root",
      "direction": "column",
      "gap": "sm",
      "children": [
        "loading-state",
        "alert",
        "emptystate",
        "loaded-content"
      ]
    }
  }
}