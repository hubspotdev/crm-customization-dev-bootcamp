  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "label": "Loading tickets...",
      "showLabel": true,
      "layout": "centered"
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Unable to load tickets",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": "Refresh to retry."
    },
    "text": {
      "type": "Text",
      "children": "All caught up \u2014 no tickets need attention right now."
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No open tickets",
      "layout": "vertical",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "text"
      ]
    },
    "statisticsitem": {
      "type": "StatisticsItem",
      "label": "Urgent SLA Today",
      "number": "$data.kpis.urgentSla",
      "numberStyle": "danger"
    },
    "statisticsitem-1": {
      "type": "StatisticsItem",
      "label": "Unassigned High Priority",
      "number": "$data.kpis.unassignedHigh",
      "numberStyle": "warning"
    },
    "statisticsitem-2": {
      "type": "StatisticsItem",
      "label": "Techs Available Now",
      "number": "$data.kpis.availableNow",
      "numberStyle": "success"
    },
    "statisticsitem-3": {
      "type": "StatisticsItem",
      "label": "Avg Jobs / Tech",
      "number": "$data.kpis.avgJobsPerTech"
    },
    "dispatch-kpis": {
      "type": "Statistics",
      "name": "dispatch-kpis",
      "children": [
        "statisticsitem",
        "statisticsitem-1",
        "statisticsitem-2",
        "statisticsitem-3"
      ]
    },
    "divider": {
      "type": "Divider"
    },
    "unassigned-table": {
      "type": "DataTable",
      "name": "unassigned-table",
      "data": "$data.unassignedTickets",
      "searchFields": [
        "customer",
        "address",
        "zone"
      ],
      "fuzzySearch": true,
      "pageSize": 10,
      "filters": [
        {
          "type": "multiselect",
          "name": "priority",
          "placeholder": "All priorities",
          "options": "$data.priorityOptions"
        },
        {
          "type": "multiselect",
          "name": "type",
          "placeholder": "All types",
          "options": "$data.typeOptions"
        }
      ],
      "columns": [
        {
          "field": "customer",
          "label": "Customer & Address",
          "sortable": false,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Flex",
              "direction": "column",
              "gap": "extra-small",
              "children": [
                {
                  "type": "Text",
                  "format": {
                    "fontWeight": "demibold"
                  },
                  "truncate": true,
                  "children": "$row.customer"
                },
                {
                  "type": "Text",
                  "variant": "microcopy",
                  "truncate": true,
                  "children": "$row.address"
                }
              ]
            }
          }
        },
        {
          "field": "type",
          "label": "Type",
          "sortable": false,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "variant": "default",
              "children": "$row.type"
            }
          }
        },
        {
          "field": "priority",
          "label": "Priority",
          "sortable": false,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "StatusTag",
              "variant": "$row.priorityVariant",
              "children": "$row.priorityLabel"
            }
          }
        },
        {
          "field": "scheduled",
          "label": "Scheduled",
          "sortable": false
        },
        {
          "field": "slaDue",
          "label": "SLA Due",
          "sortable": false
        },
        {
          "field": "zone",
          "label": "Zone",
          "sortable": false
        },
        {
          "field": "id",
          "label": "Action",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Button",
              "size": "xs",
              "variant": "primary",
              "overlay": {
                "type": "Panel",
                "id": "assign-panel-{{row.id}}",
                "title": "Assign Tech \u2014 {{row.customer}}",
                "width": "sm",
                "children": [
                  {
                    "type": "PanelBody",
                    "children": [
                      {
                        "type": "PanelSection",
                        "title": "Job Details",
                        "children": [
                          {
                            "type": "DescriptionList",
                            "direction": "row",
                            "children": [
                              {
                                "type": "DescriptionListItem",
                                "label": "Address",
                                "children": {
                                  "type": "Text",
                                  "children": "{{row.address}}"
                                }
                              },
                              {
                                "type": "DescriptionListItem",
                                "label": "Type",
                                "children": {
                                  "type": "Text",
                                  "children": "{{row.type}}"
                                }
                              },
                              {
                                "type": "DescriptionListItem",
                                "label": "Scheduled",
                                "children": {
                                  "type": "Text",
                                  "children": "{{row.scheduled}}"
                                }
                              },
                              {
                                "type": "DescriptionListItem",
                                "label": "SLA Due",
                                "children": {
                                  "type": "Text",
                                  "children": "{{row.slaDue}}"
                                }
                              },
                              {
                                "type": "DescriptionListItem",
                                "label": "Zone",
                                "children": {
                                  "type": "Text",
                                  "children": "{{row.zone}}"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "PanelSection",
                        "title": "Available Techs",
                        "children": [
                          {
                            "type": "Flex",
                            "name": "tech-list",
                            "direction": "column",
                            "gap": "sm",
                            "children": [
                              {
                                "type": "Tile",
                                "compact": true,
                                "children": [
                                  {
                                    "type": "Flex",
