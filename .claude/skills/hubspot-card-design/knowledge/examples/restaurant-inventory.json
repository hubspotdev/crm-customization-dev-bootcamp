  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "label": "Loading inventory...",
      "layout": "centered",
      "showLabel": true
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Failed to load inventory",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": "Could not retrieve inventory data from the server. Please try again."
    },
    "text": {
      "type": "Text",
      "children": "$data.restaurant.name"
    },
    "descriptionlistitem": {
      "type": "DescriptionListItem",
      "label": "Restaurant",
      "children": [
        "text"
      ]
    },
    "text-1": {
      "type": "Text",
      "children": "$data.restaurant.location"
    },
    "descriptionlistitem-1": {
      "type": "DescriptionListItem",
      "label": "Location",
      "children": [
        "text-1"
      ]
    },
    "text-2": {
      "type": "Text",
      "children": "$data.restaurant.kitchenManager"
    },
    "descriptionlistitem-2": {
      "type": "DescriptionListItem",
      "label": "Kitchen manager",
      "children": [
        "text-2"
      ]
    },
    "restaurant-identity": {
      "type": "DescriptionList",
      "name": "restaurant-identity",
      "direction": "row",
      "children": [
        "descriptionlistitem",
        "descriptionlistitem-1",
        "descriptionlistitem-2"
      ]
    },
    "divider": {
      "type": "Divider"
    },
    "text-3": {
      "type": "Text",
      "children": "Add ingredients to start tracking your kitchen inventory and par levels."
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No inventory items",
      "layout": "vertical",
      "children": [
        "text-3"
      ]
    },
    "empty-state": {
      "type": "Flex",
      "name": "empty-state",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "restaurant-identity",
        "divider",
        "emptystate"
      ]
    },
    "inventory-health": {
      "type": "ProgressBar",
      "name": "inventory-health",
      "title": "Inventory health",
      "value": "$data.inventoryHealth.healthyCount",
      "maxValue": "$data.inventoryHealth.totalCount",
      "showPercentage": true,
      "valueDescription": "$data.inventoryHealth.valueDescription",
      "variant": "$data.inventoryHealth.variant"
    },
    "text-4": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "Needs reorder"
    },
    "tag": {
      "type": "Tag",
      "variant": "$data.reorderSummary.tagVariant",
      "children": "{{data.reorderSummary.count}}"
    },
    "text-5": {
      "type": "Text",
      "variant": "microcopy",
      "visible": "$data.reorderSummary.showSortedByUrgency",
      "children": "Sorted by urgency"
    },
    "needs-reorder-header": {
      "type": "Flex",
      "name": "needs-reorder-header",
      "direction": "row",
      "gap": "xs",
      "align": "center",
      "children": [
        "text-4",
        "tag",
        "text-5"
      ]
    },
    "text-6": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$item.name"
    },
    "tag-1": {
      "type": "Tag",
      "variant": "$item.triageTagVariant",
      "children": "$item.triageTagLabel"
    },
    "flex-1": {
      "type": "Flex",
      "direction": "row",
      "justify": "between",
      "align": "center",
      "children": [
        "text-6",
        "tag-1"
      ]
    },
    "text-7": {
      "type": "Text",
      "children": "$item.quantityVsParLabel"
    },
    "text-8": {
      "type": "Text",
      "variant": "microcopy",
      "children": "$item.supplier"
    },
    "flex-2": {
      "type": "Flex",
      "direction": "row",
      "justify": "between",
      "align": "center",
      "children": [
        "text-7",
        "text-8"
      ]
    },
    "button": {
      "type": "Button",
      "size": "extra-small",
      "variant": "secondary",
      "overlay": {
        "type": "Modal",
        "id": "adjust-modal-{{item.id}}",
        "title": "Adjust \u2014 {{item.name}}",
        "width": "small",
        "children": [
          {
            "type": "ModalBody",
            "children": [
              {
                "type": "Flex",
                "direction": "column",
                "gap": "sm",
                "children": [
                  {
                    "type": "DescriptionList",
                    "direction": "column",
                    "children": [
                      {
                        "type": "DescriptionListItem",
                        "label": "Current stock",
                        "children": [
                          {
                            "type": "Text",
                            "children": "{{item.quantity}} {{item.unit}}"
                          }
                        ]
                      },
                      {
                        "type": "DescriptionListItem",
                        "label": "Par level",
                        "children": [
                          {
                            "type": "Text",
                            "children": "{{item.par}} {{item.unit}}"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "NumberInput",
                    "label": "New quantity ({{item.unit}})",
                    "required": true,
                    "min": 0,
                    "placeholder": "Enter updated quantity"
                  }
                ]
              }
            ]
          },
          {
            "type": "ModalFooter",
            "children": [
              {
                "type": "Button",
                "variant": "secondary",
                "onClick": {
                  "$action": "closeOverlay",
                  "id": "adjust-modal-{{item.id}}"
                },
                "children": "Cancel"
              },
              {
                "type": "LoadingButton",
                "variant": "primary",
                "children": "Save"
              }
            ]
          }
        ]
      },
      "children": "Adjust"
    },
    "flex": {
      "type": "Flex",
      "direction": "column",
      "gap": "xs",
      "children": [
        "flex-1",
        "flex-2",
        "button"
      ]
    },
    "reorder-grid": {
      "type": "AutoGrid",
      "name": "reorder-grid",
      "columnWidth": 250,
      "flexible": true,
      "gap": "small",
      "children": [
        {
          "$forEach": "$data.reorderItems",
          "as": "item",
          "render": {
            "type": "Tile",
            "compact": true,
            "children": [
              "flex"
            ]
          }
        }
      ]
    },
    "needs-reorder-section": {
      "type": "Flex",
      "name": "needs-reorder-section",
      "direction": "column",
      "gap": "xs",
      "children": [
        "needs-reorder-header",
        "reorder-grid"
      ]
    },
    "divider-1": {
      "type": "Divider"
    },
    "text-9": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "All inventory"
    },
    "inventory-table": {
      "type": "DataTable",
      "name": "inventory-table",
      "data": "$data.inventoryRows",
      "searchFields": [
        "name",
        "supplier"
      ],
      "searchPlaceholder": "Search ingredients...",
      "pageSize": 7,
      "filters": [
        {
          "type": "select",
          "name": "categoryKey",
          "placeholder": "All categories",
          "options": "$data.categoryFilterOptions"
        },
        {
          "type": "select",
          "name": "statusKey",
          "placeholder": "All statuses",
          "options": "$data.statusFilterOptions"
        }
      ],
      "columns": [
        {
          "field": "name",
          "label": "Item",
          "sortable": true
        },
        {
          "field": "supplier",
          "label": "Supplier",
          "sortable": true
        },
        {
          "field": "category",
          "label": "Category",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "variant": "$row.categoryVariant",
              "children": "$value"
            }
          }
        },
        {
          "field": "onHand",
          "label": "On hand",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Text",
              "format": {
                "fontWeight": "demibold"
              },
              "children": "$value"
            }
          }
        },
        {
          "field": "par",
          "label": "Par"
        },
        {
          "field": "status",
          "label": "Status",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "variant": "$row.statusVariant",
              "children": "$value"
            }
          }
        }
      ],
      "emptyTitle": "No results found",
      "emptyMessage": "No ingredients match your current filters."
    },
    "inventory-table-section": {
      "type": "Flex",
      "name": "inventory-table-section",
      "direction": "column",
      "gap": "xs",
      "children": [
        "text-9",
        "inventory-table"
      ]
    },
    "loaded-content": {
      "type": "Flex",
      "name": "loaded-content",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loaded"
        ]
      },
      "children": [
        "inventory-health",
        "needs-reorder-section",
        "divider-1",
        "inventory-table-section"
      ]
    },
    "card-root": {
      "type": "Flex",
      "name": "card-root",
      "direction": "column",
      "gap": "sm",
      "children": [
        "loading-state",
        "alert",
        "empty-state",
        "loaded-content"
      ]
    }
  }
}