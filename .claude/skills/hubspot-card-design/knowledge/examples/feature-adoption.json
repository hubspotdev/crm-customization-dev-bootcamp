  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "label": "Loading feature data...",
      "layout": "centered",
      "showLabel": true
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "error-company-name-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.name"
    },
    "error-company-item": {
      "type": "DescriptionListItem",
      "label": "Company",
      "children": [
        "error-company-name-text"
      ]
    },
    "error-plan-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.plan"
    },
    "error-plan-item": {
      "type": "DescriptionListItem",
      "label": "Plan",
      "children": [
        "error-plan-text"
      ]
    },
    "error-csm-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.csm"
    },
    "error-csm-item": {
      "type": "DescriptionListItem",
      "label": "CSM",
      "children": [
        "error-csm-text"
      ]
    },
    "error-context-bar": {
      "type": "DescriptionList",
      "direction": "row",
      "children": [
        "error-company-item",
        "error-plan-item",
        "error-csm-item"
      ]
    },
    "error-alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Unable to load feature data",
      "children": "Feature adoption data could not be retrieved. The analytics service may be temporarily unavailable. Please try again in a few minutes."
    },
    "error-state": {
      "type": "Flex",
      "name": "error-state",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": [
        "error-context-bar",
        "error-alert"
      ]
    },
    "empty-company-name-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.name"
    },
    "empty-company-item": {
      "type": "DescriptionListItem",
      "label": "Company",
      "children": [
        "empty-company-name-text"
      ]
    },
    "empty-plan-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.plan"
    },
    "empty-plan-item": {
      "type": "DescriptionListItem",
      "label": "Plan",
      "children": [
        "empty-plan-text"
      ]
    },
    "empty-csm-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.csm"
    },
    "empty-csm-item": {
      "type": "DescriptionListItem",
      "label": "CSM",
      "children": [
        "empty-csm-text"
      ]
    },
    "empty-context-bar": {
      "type": "DescriptionList",
      "direction": "row",
      "children": [
        "empty-company-item",
        "empty-plan-item",
        "empty-csm-item"
      ]
    },
    "empty-divider": {
      "type": "Divider"
    },
    "empty-body-text": {
      "type": "Text",
      "children": "Feature adoption tracking has not been configured for this account. Connect the product analytics integration to start monitoring usage."
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No feature data available",
      "layout": "vertical",
      "imageName": "reporting",
      "imageWidth": 120,
      "children": [
        "empty-body-text"
      ]
    },
    "empty-state": {
      "type": "Flex",
      "name": "empty-state",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "empty-context-bar",
        "empty-divider",
        "emptystate"
      ]
    },
    "adoption-progressbar": {
      "type": "ProgressBar",
      "title": "Feature adoption",
      "value": "$data.adoption.score",
      "maxValue": 100,
      "showPercentage": true,
      "valueDescription": "$data.adoption.valueDescription",
      "variant": "$data.adoption.variant"
    },
    "company-name-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.name"
    },
    "company-item": {
      "type": "DescriptionListItem",
      "label": "Company",
      "children": [
        "company-name-text"
      ]
    },
    "plan-tag": {
      "type": "Tag",
      "variant": "info",
      "children": "$data.company.plan"
    },
    "plan-item": {
      "type": "DescriptionListItem",
      "label": "Plan",
      "children": [
        "plan-tag"
      ]
    },
    "csm-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.csm"
    },
    "csm-item": {
      "type": "DescriptionListItem",
      "label": "CSM",
      "children": [
        "csm-text"
      ]
    },
    "renewal-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.company.renewalDateLabel"
    },
    "renewal-item": {
      "type": "DescriptionListItem",
      "label": "Renewal",
      "children": [
        "renewal-text"
      ]
    },
    "company-context-bar": {
      "type": "DescriptionList",
      "name": "company-context-bar",
      "direction": "row",
      "children": [
        "company-item",
        "plan-item",
        "csm-item",
        "renewal-item"
      ]
    },
    "gap-header-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "Needs attention"
    },
    "gap-header-tag": {
      "type": "Tag",
      "variant": "warning",
      "children": "$data.gapSectionCountLabel"
    },
    "gap-header": {
      "type": "Flex",
      "name": "gap-header",
      "direction": "row",
      "align": "center",
      "gap": "xs",
      "children": [
        "gap-header-text",
        "gap-header-tag"
      ]
    },
    "gap-grid": {
      "type": "AutoGrid",
      "name": "gap-grid",
      "columnWidth": 250,
      "flexible": true,
      "gap": "small",
      "children": [
        {
          "$forEach": "$data.gapFeatures",
          "as": "feature",
          "render": {
            "type": "Tile",
            "compact": true,
            "children": [
              {
                "type": "Flex",
                "direction": "column",
                "gap": "xs",
                "children": [
                  {
                    "type": "Text",
                    "format": {
                      "fontWeight": "demibold"
                    },
                    "children": "$feature.name"
                  },
                  {
                    "type": "Tag",
                    "variant": "$feature.statusVariant",
                    "children": "$feature.statusLabel"
                  },
                  {
                    "type": "Button",
                    "size": "extra-small",
                    "variant": "secondary",
                    "overlay": {
                      "type": "Modal",
                      "id": "flag-modal-{{feature.id}}",
                      "title": "Flag feature gap",
                      "width": "medium",
                      "children": [
                        {
                          "type": "ModalBody",
                          "children": [
                            {
                              "type": "Flex",
                              "direction": "column",
                              "gap": "sm",
                              "children": [
                                {
                                  "type": "DescriptionList",
                                  "direction": "column",
                                  "children": [
                                    {
                                      "type": "DescriptionListItem",
                                      "label": "Feature",
                                      "children": [
                                        {
                                          "type": "Text",
                                          "format": {
                                            "fontWeight": "demibold"
                                          },
                                          "children": "$feature.name"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "DescriptionListItem",
                                      "label": "Product area",
                                      "children": [
                                        {
                                          "type": "Text",
                                          "children": "$feature.group"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "DescriptionListItem",
                                      "label": "Status",
                                      "children": [
                                        {
                                          "type": "Tag",
                                          "variant": "$feature.statusVariant",
                                          "children": "$feature.statusLabel"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "DescriptionListItem",
                                      "label": "Last used",
                                      "children": [
                                        {
                                          "type": "Text",
                                          "children": "$feature.lastUsedLabel"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "Divider"
                                },
                                {
                                  "type": "Alert",
                                  "variant": "tip",
                                  "title": "Coaching opportunity",
                                  "children": "$feature.coachingMessage"
                                },
                                {
                                  "type": "TextArea",
                                  "name": "follow-up-notes",
                                  "label": "Follow-up notes",
                                  "placeholder": "Add context for your next check-in with this customer..."
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "ModalFooter",
                          "children": [
                            {
                              "type": "Button",
                              "variant": "secondary",
                              "onClick": {
                                "$action": "closeOverlay",
                                "id": "flag-modal-{{feature.id}}"
                              },
                              "children": "Cancel"
                            },
                            {
                              "type": "LoadingButton",
                              "variant": "primary",
                              "children": "Flag for follow-up"
                            }
                          ]
                        }
                      ]
                    },
                    "children": "Flag gap"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "gap-section": {
      "type": "Flex",
      "name": "gap-section",
      "direction": "column",
      "gap": "xs",
      "visible": "$data.adoption.hasGaps",
      "children": [
        "gap-header",
        "gap-grid"
      ]
    },
    "full-adoption-alert": {
      "type": "Alert",
      "name": "full-adoption-alert",
      "variant": "success",
      "title": "Full adoption",
      "visible": {
        "$eq": [
          "$data.adoption.hasGaps",
          false
        ]
      },
      "children": "$data.adoption.fullAdoptionMessage"
    },
    "divider": {
      "type": "Divider"
    },
    "groups-section": {
      "type": "Flex",
      "name": "groups-section",
      "direction": "column",
      "gap": "sm",
      "children": [
        {
          "$forEach": "$data.productGroups",
          "as": "group",
          "render": {
            "type": "Accordion",
            "title": "$group.name",
            "defaultOpen": "$group.defaultOpen",
            "size": "sm",
            "children": [
              {
                "type": "Flex",
                "direction": "column",
                "gap": "flush",
                "children": [
                  {
                    "type": "Text",
                    "children": "$group.summaryLabel"
                  },
                  {
                    "type": "DataTable",
                    "bordered": true,
                    "flush": true,
                    "data": "$group.features",
                    "columns": [
                      {
                        "field": "name",
                        "label": "Feature",
                        "width": "auto",
                        "renderCell": {
                          "$render": [
                            "value",
                            "row"
                          ],
                          "node": {
                            "type": "Flex",
                            "direction": "row",
                            "align": "center",
                            "gap": "xs",
                            "children": [
                              {
                                "type": "Text",
                                "children": "$row.name"
                              },
                              {
                                "type": "Tag",
                                "variant": "info",
                                "visible": "$row.addonTagVisible",
                                "children": "Add-on"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "field": "status",
                        "label": "Status",
                        "width": "min",
                        "renderCell": {
                          "$render": [
                            "value",
                            "row"
                          ],
                          "node": {
                            "type": "Tag",
                            "variant": "$row.statusVariant",
                            "children": "$row.statusLabel"
                          }
                        }
                      },
                      {
                        "field": "lastUsed",
                        "label": "Last used",
                        "width": "min",
                        "renderCell": {
                          "$render": [
                            "value",
                            "row"
                          ],
                          "node": {
                            "type": "Text",
                            "children": "$row.lastUsedLabel"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "loaded-content": {
      "type": "Flex",
      "name": "loaded-content",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loaded"
        ]
      },
      "children": [
        "adoption-progressbar",
        "company-context-bar",
        "gap-section",
        "full-adoption-alert",
        "divider",
        "groups-section"
      ]
    },
    "card-root": {
      "type": "Flex",
      "name": "card-root",
      "direction": "column",
      "gap": "sm",
      "children": [
        "loading-state",
        "error-state",
        "empty-state",
        "loaded-content"
      ]
    }
  }
}