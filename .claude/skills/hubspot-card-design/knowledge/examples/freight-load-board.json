                            "type": "Text",
                            "format": {
                              "fontWeight": "demibold"
                            },
                            "children": "$load.id"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "TableCell",
                    "width": "auto",
                    "children": [
                      {
                        "type": "Text",
                        "children": "$load.routeLabel"
                      }
                    ]
                  },
                  {
                    "type": "TableCell",
                    "width": "min",
                    "children": [
                      {
                        "type": "Text",
                        "children": "$load.weightLabel"
