                                                  "type": "Text",
                                                  "children": "$load.weightLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Miles",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.milesLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Rate",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "format": {
                                                    "fontWeight": "demibold"
                                                  },
                                                  "children": "$load.rateLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Rate per mile",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.ratePerMileLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Commodity",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.commodity"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Broker",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.broker"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "Divider",
                                          "visible": "$load.hasNotes"
                                        },
                                        {
                                          "type": "Flex",
                                          "visible": "$load.hasNotes",
                                          "direction": "column",
                                          "gap": "flush",
                                          "children": [
                                            {
                                              "type": "Text",
                                              "variant": "microcopy",
                                              "children": "Notes"
                                            },
                                            {
                                              "type": "Text",
                                              "children": "$load.notes"
