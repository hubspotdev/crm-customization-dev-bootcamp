  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "label": "Loading load board...",
      "layout": "centered",
      "showLabel": true
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Failed to load freight data",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": "Could not retrieve load board data from the TMS. Please check your API connection and try again."
    },
    "carrier-name-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.carrier.name"
    },
    "carrier-name-item": {
      "type": "DescriptionListItem",
      "label": "Carrier",
      "children": [
        "carrier-name-text"
      ]
    },
    "carrier-mc-text": {
      "type": "Text",
      "children": "$data.carrier.mcNumber"
    },
    "carrier-mc-item": {
      "type": "DescriptionListItem",
      "label": "MC #",
      "children": [
        "carrier-mc-text"
      ]
    },
    "carrier-dot-text": {
      "type": "Text",
      "children": "$data.carrier.dotNumber"
    },
    "carrier-dot-item": {
      "type": "DescriptionListItem",
      "label": "DOT #",
      "children": [
        "carrier-dot-text"
      ]
    },
    "carrier-base-text": {
      "type": "Text",
      "children": "$data.carrier.baseCity"
    },
    "carrier-base-item": {
      "type": "DescriptionListItem",
      "label": "Base",
      "children": [
        "carrier-base-text"
      ]
    },
    "carrier-identity": {
      "type": "DescriptionList",
      "name": "carrier-identity",
      "direction": "row",
      "children": [
        "carrier-name-item",
        "carrier-mc-item",
        "carrier-dot-item",
        "carrier-base-item"
      ]
    },
    "empty-divider": {
      "type": "Divider"
    },
    "empty-body-text": {
      "type": "Text",
      "children": "There are no loads currently assigned to this carrier. New loads will appear here as they are posted to the board."
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No loads available",
      "layout": "vertical",
      "children": [
        "empty-body-text"
      ]
    },
    "empty-state": {
      "type": "Flex",
      "name": "empty-state",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "carrier-identity",
        "empty-divider",
        "emptystate"
      ]
    },
    "utilization-bar": {
      "type": "ProgressBar",
      "name": "utilization-bar",
      "title": "Carrier utilization",
      "value": "$data.utilization.activeTrucks",
      "maxValue": "$data.utilization.totalTrucks",
      "showPercentage": true,
      "valueDescription": "$data.utilization.valueDescription",
      "variant": "$data.utilization.variant"
    },
    "divider": {
      "type": "Divider"
    },
    "today-header-label": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.todayHeader.label"
    },
    "today-header-tag": {
      "type": "Tag",
      "variant": "error",
      "children": "$data.todayHeader.hotCountLabel"
    },
    "today-header": {
      "type": "Flex",
      "name": "today-header",
      "direction": "row",
      "gap": "xs",
      "align": "center",
      "children": [
        "today-header-label",
        "today-header-tag"
      ]
    },
    "today-grid": {
      "type": "AutoGrid",
      "name": "today-grid",
      "columnWidth": 250,
      "flexible": true,
      "gap": "small",
      "children": [
        {
          "$forEach": "$data.todayLoads",
          "as": "load",
          "render": {
            "type": "Tile",
            "compact": true,
            "children": [
              {
                "type": "Flex",
                "direction": "column",
                "gap": "xs",
                "children": [
                  {
                    "type": "Flex",
                    "direction": "row",
                    "justify": "between",
                    "align": "center",
                    "children": [
                      {
                        "type": "Link",
                        "overlay": {
                          "type": "Panel",
                          "id": "load-panel-today-{{load.id}}",
                          "title": "Load {{load.id}}",
                          "width": "small",
                          "variant": "modal",
                          "flush": true,
                          "children": [
                            {
                              "type": "PanelBody",
                              "children": [
                                {
                                  "type": "PanelSection",
                                  "children": [
                                    {
                                      "type": "Flex",
                                      "direction": "column",
                                      "gap": "sm",
                                      "children": [
                                        {
                                          "type": "DescriptionList",
                                          "direction": "column",
                                          "children": [
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Route",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "format": {
                                                    "fontWeight": "demibold"
                                                  },
                                                  "children": "$load.routeLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Pickup date",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.pickupDateLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Pickup window",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.pickupWindow"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Weight",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.weightLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Miles",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.milesLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Rate",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "format": {
                                                    "fontWeight": "demibold"
                                                  },
                                                  "children": "$load.rateLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Rate per mile",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.ratePerMileLabel"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Commodity",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.commodity"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "DescriptionListItem",
                                              "label": "Broker",
                                              "children": [
                                                {
                                                  "type": "Text",
                                                  "children": "$load.broker"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "Divider",
                                          "visible": "$load.hasNotes"
                                        },
                                        {
                                          "type": "Flex",
                                          "visible": "$load.hasNotes",
                                          "direction": "column",
                                          "gap": "flush",
                                          "children": [
                                            {
                                              "type": "Text",
                                              "variant": "microcopy",
                                              "children": "Notes"
                                            },
                                            {
                                              "type": "Text",
                                              "children": "$load.notes"
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        "children": [
                          {
                            "type": "Text",
                            "format": {
                              "fontWeight": "demibold"
                            },
                            "children": "$load.id"
                          }
                        ]
                      },
                      {
                        "type": "Text",
                        "variant": "microcopy",
                        "format": {
                          "fontWeight": "demibold"
                        },
                        "children": "$load.rateLabel"
                      }
                    ]
                  },
                  {
                    "type": "Text",
                    "children": "$load.routeLabel"
                  },
                  {
                    "type": "Flex",
                    "direction": "row",
                    "justify": "between",
                    "children": [
                      {
                        "type": "Text",
                        "variant": "microcopy",
                        "children": "$load.weightLabel"
                      },
                      {
                        "type": "Text",
                        "variant": "microcopy",
                        "children": "Pickup: {{load.pickupWindow}}"
                      }
                    ]
                  },
                  {
                    "type": "Select",
                    "name": "assign-{{load.id}}",
                    "label": "Assign truck",
                    "variant": "transparent",
                    "placeholder": "Select truck...",
                    "options": "$data.truckOptions"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "today-section": {
      "type": "Flex",
      "name": "today-section",
      "direction": "column",
      "gap": "xs",
      "children": [
        "today-header",
        "today-grid"
      ]
    },
    "divider-1": {
      "type": "Divider"
    },
    "tomorrow-header-label": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.tomorrowHeader.label"
    },
    "tomorrow-header-count": {
      "type": "Text",
      "variant": "microcopy",
      "children": "$data.tomorrowHeader.countLabel"
    },
    "tomorrow-header": {
      "type": "Flex",
      "name": "tomorrow-header",
      "direction": "row",
      "gap": "xs",
      "align": "center",
      "children": [
        "tomorrow-header-label",
        "tomorrow-header-count"
      ]
    },
    "tomorrow-table": {
      "type": "Table",
      "name": "tomorrow-table",
      "bordered": true,
      "flush": true,
      "children": [
        {
          "type": "TableHead",
          "children": [
            {
              "type": "TableRow",
              "children": [
                {
                  "type": "TableHeader",
                  "width": "min",
                  "sortDirection": "never",
                  "children": "Load"
                },
                {
                  "type": "TableHeader",
                  "width": "auto",
                  "sortDirection": "never",
                  "children": "Route"
                },
                {
                  "type": "TableHeader",
                  "width": "min",
                  "sortDirection": "never",
                  "children": "Weight"
                },
                {
                  "type": "TableHeader",
                  "width": "min",
                  "sortDirection": "never",
                  "children": "Pickup"
                },
                {
                  "type": "TableHeader",
                  "width": "min",
                  "sortDirection": "never",
                  "children": "Rate"
                },
                {
                  "type": "TableHeader",
                  "width": "min",
                  "sortDirection": "never",
                  "children": "Truck"
                }
              ]
            }
          ]
        },
        {
          "type": "TableBody",
          "children": [
            {
              "$forEach": "$data.tomorrowLoads",
              "as": "load",
              "render": {
                "type": "TableRow",
                "children": [
                  {
                    "type": "TableCell",
                    "width": "min",
                    "children": [
                      {
                        "type": "Link",
                        "overlay": {
