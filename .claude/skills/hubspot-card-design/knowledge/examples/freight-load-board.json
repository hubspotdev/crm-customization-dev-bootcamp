                              {
                                "type": "Flex",
                                "visible": "$row.hasNotes",
                                "direction": "column",
                                "gap": "flush",
                                "children": [
                                  {
                                    "type": "Text",
                                    "variant": "microcopy",
                                    "children": "Notes"
                                  },
                                  {
                                    "type": "Text",
                                    "children": "$row.notes"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "children": [
                {
                  "type": "Text",
                  "format": {
                    "fontWeight": "demibold"
                  },
                  "children": "$value"
                }
              ]
            }
          }
        },
        {
          "field": "routeLabel",
          "label": "Route"
        },
        {
          "field": "weightLabel",
          "label": "Weight"
        },
        {
          "field": "pickupDateLabel",
          "label": "Date"
        },
        {
          "field": "pickupWindow",
          "label": "Pickup"
        },
        {
          "field": "rateLabel",
          "label": "Rate",
          "renderCell": {
            "$render": [
