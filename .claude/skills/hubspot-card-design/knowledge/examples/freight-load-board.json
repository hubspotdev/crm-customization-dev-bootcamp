                                        "type": "Text",
                                        "children": "$row.pickupWindow"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Weight",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.weightLabel"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Miles",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.milesLabel"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Rate",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "format": {
                                          "fontWeight": "demibold"
                                        },
                                        "children": "$row.rateLabel"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Rate per mile",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.ratePerMileLabel"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Commodity",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.commodity"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Broker",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.broker"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "type": "Divider",
                                "visible": "$row.hasNotes"
