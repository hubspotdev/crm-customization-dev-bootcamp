  "root": "card-root",
  "elements": {
    "card-root": {
      "type": "Flex",
      "name": "card-root",
      "direction": "column",
      "gap": "md",
      "children": [
        "header-row",
        "deals-table"
      ]
    },
    "header-row": {
      "type": "Flex",
      "name": "header-row",
      "direction": "row",
      "justify": "between",
      "align": "end",
      "gap": "md",
      "children": [
        {
          "type": "Statistics",
          "children": {
            "$forEach": "$data.kpis",
            "as": "kpi",
            "render": {
              "type": "StatisticsItem",
              "label": "$kpi.label",
              "number": "$kpi.value"
            }
          }
        },
        "log-deal-button"
      ]
    },
    "log-deal-button": {
      "type": "Button",
      "variant": "primary",
      "size": "small",
      "overlay": {
        "type": "Modal",
        "id": "log-deal-modal",
        "title": "Log new deal",
        "width": "large",
        "children": [
          {
            "type": "ModalBody",
            "children": [
              {
                "type": "FormBuilder",
                "name": "log-deal-form",
                "columns": 2,
                "submitAlign": "between",
                "labels": {
                  "submit": "Save deal",
                  "cancel": "Cancel"
                },
                "onCancel": {
                  "$action": "closeOverlay",
                  "id": "log-deal-modal"
                },
                "onSubmit": {
                  "$action": "batch",
                  "actions": [
                    {
                      "$action": "closeOverlay",
                      "id": "log-deal-modal"
                    },
                    {
                      "$action": "addAlert",
                      "type": "success",
                      "title": "Deal saved",
                      "message": "Owner notified and forecast refreshed."
                    }
                  ]
                },
                "fields": [
                  {
                    "type": "text",
                    "name": "name",
                    "label": "Deal name",
                    "required": true,
                    "colSpan": 2,
                    "placeholder": "e.g. Atlas Cloud — Platform expansion"
                  },
                  {
                    "type": "text",
                    "name": "company",
                    "label": "Company",
                    "required": true
                  },
                  {
                    "type": "select",
                    "name": "segment",
                    "label": "Segment",
                    "required": true,
                    "options": "$data.segmentOptions"
                  },
                  {
                    "type": "select",
                    "name": "stage",
                    "label": "Stage",
                    "required": true,
                    "options": "$data.stageOptions",
                    "defaultValue": "discovery"
                  },
                  {
                    "type": "select",
                    "name": "owner",
                    "label": "Owner",
                    "required": true,
                    "options": "$data.ownerOptions"
                  },
                  {
                    "type": "currency",
                    "name": "amount",
                    "label": "Amount",
                    "currency": "USD",
                    "required": true
                  },
                  {
                    "type": "number",
                    "name": "probability",
                    "label": "Win probability (%)",
                    "min": 0,
                    "max": 100
                  },
                  {
                    "type": "date",
                    "name": "closeDate",
                    "label": "Expected close date",
                    "format": "long",
                    "colSpan": 2
                  }
                ]
              }
            ]
          }
        ]
      },
      "children": "+ Log new deal"
    },
    "deals-table": {
      "type": "DataTable",
      "name": "deals-table",
      "data": "$data.deals",
      "title": "Open deals",
      "searchFields": ["name", "company", "owner"],
      "fuzzySearch": true,
      "pageSize": 15,
      "defaultSort": { "closeDate": "ascending" },
      "groupBy": "stageLabel",
      "selectable": true,
      "recordLabel": { "singular": "deal", "plural": "deals" },
      "selectionActions": [
        {
          "label": "Reassign owner",
          "icon": "user",
          "onClick": {
            "$action": "addAlert",
            "type": "info",
            "title": "Reassign owner",
            "message": "Would open the owner picker for the selected deals."
          }
        },
        {
          "label": "Move stage",
          "icon": "moveTo",
          "onClick": {
            "$action": "addAlert",
            "type": "info",
            "title": "Move stage",
            "message": "Would open the stage picker for the selected deals."
          }
        },
        {
          "label": "Archive",
          "icon": "delete",
          "variant": "destructive",
          "onClick": {
            "$action": "addAlert",
            "type": "warning",
            "title": "Archive",
            "message": "Selected deals would be archived (recoverable for 30 days)."
          }
        }
      ],
      "filters": [
        {
          "type": "multiselect",
          "name": "stage",
          "placeholder": "All stages",
          "options": "$data.stageOptions"
        },
        {
          "type": "multiselect",
          "name": "owner",
          "placeholder": "All owners",
          "options": "$data.ownerOptions"
        },
        {
          "type": "select",
          "name": "segment",
          "placeholder": "All segments",
          "options": "$data.segmentOptions"
        }
      ],
      "columns": [
        {
          "field": "name",
          "label": "Deal",
          "sortable": true,
          "width": 260,
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "Flex",
              "direction": "column",
              "gap": "flush",
              "children": [
                {
                  "type": "Link",
                  "onClick": {
                    "$action": "addAlert",
                    "type": "info",
                    "title": "Open deal",
                    "message": "Would navigate to {{row.id}}."
                  },
                  "children": "$value"
                },
                {
                  "type": "Text",
                  "variant": "microcopy",
                  "children": "{{row.company}}"
                }
              ]
            }
          }
        },
        {
          "field": "stageLabel",
          "label": "Stage",
          "sortable": true,
          "width": 130,
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "StatusTag",
              "variant": "$row.stageVariant",
              "children": "$value"
            }
          }
        },
        {
          "field": "segment",
          "label": "Segment",
          "sortable": true,
          "width": 120,
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "Tag",
              "variant": "$row.segmentVariant",
              "children": "$value"
            }
          }
        },
        {
          "field": "amount",
          "label": "Amount",
          "sortable": true,
          "align": "right",
          "width": 120,
          "footer": "$data.totalLabel",
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "Text",
              "format": { "fontWeight": "demibold" },
              "children": "$row.amountLabel"
            }
          }
        },
        {
          "field": "probability",
          "label": "Win %",
          "sortable": true,
          "align": "center",
          "width": 100,
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "Text",
              "variant": "microcopy",
              "children": "{{row.probabilityLabel}}"
            }
          }
        },
        {
          "field": "closeDate",
          "label": "Close date",
          "sortable": true,
          "width": 130,
          "footer": "Total",
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "Text",
              "children": "{{row.closeDateLabel}}"
            }
          }
        },
        {
          "field": "owner",
          "label": "Owner",
          "sortable": true,
          "width": 150,
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "Text",
              "variant": "microcopy",
              "children": "$value"
            }
          }
        },
        {
          "field": "id",
          "label": "",
          "width": 60,
          "align": "right",
          "renderCell": {
            "$render": ["value", "row"],
            "node": {
              "type": "Link",
              "overlay": {
                "type": "Modal",
                "id": "edit-deal-{{row.id}}",
                "title": "Edit {{row.name}}",
                "width": "large",
                "children": [
                  {
                    "type": "ModalBody",
                    "children": [
                      {
                        "type": "FormBuilder",
                        "name": "edit-deal-form",
                        "columns": 2,
                        "submitAlign": "between",
                        "values": "$row",
                        "labels": {
                          "submit": "Save changes",
                          "cancel": "Cancel"
                        },
                        "onCancel": {
                          "$action": "closeOverlay",
                          "id": "edit-deal-{{row.id}}"
                        },
                        "onSubmit": {
                          "$action": "batch",
                          "actions": [
                            {
                              "$action": "closeOverlay",
                              "id": "edit-deal-{{row.id}}"
                            },
                            {
                              "$action": "addAlert",
                              "type": "success",
                              "title": "Deal updated",
                              "message": "Saved changes to {{row.name}}."
                            }
                          ]
                        },
                        "fields": [
                          {
                            "type": "text",
                            "name": "name",
                            "label": "Deal name",
                            "required": true,
                            "colSpan": 2
                          },
                          {
                            "type": "select",
                            "name": "stage",
                            "label": "Stage",
                            "required": true,
                            "options": "$data.stageOptions"
                          },
                          {
                            "type": "select",
                            "name": "owner",
                            "label": "Owner",
                            "required": true,
                            "options": "$data.ownerOptions"
                          },
                          {
                            "type": "currency",
                            "name": "amount",
                            "label": "Amount",
                            "currency": "USD",
                            "required": true
                          },
                          {
                            "type": "number",
                            "name": "probability",
                            "label": "Win probability (%)",
                            "min": 0,
                            "max": 100
                          },
                          {
                            "type": "date",
                            "name": "closeDate",
                            "label": "Expected close date",
                            "format": "long",
                            "colSpan": 2
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "children": [
                {
                  "type": "Icon",
                  "name": "edit",
                  "screenReaderText": "Edit deal"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
