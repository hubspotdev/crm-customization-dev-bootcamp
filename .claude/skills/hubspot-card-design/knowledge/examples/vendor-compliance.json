  "root": "card-root",
  "elements": {
    "loadingspinner": {
      "type": "LoadingSpinner",
      "size": "sm",
      "label": "Loading compliance data...",
      "layout": "centered",
      "showLabel": true
    },
    "loading-state": {
      "type": "Flex",
      "name": "loading-state",
      "align": "center",
      "justify": "center",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loading"
        ]
      },
      "children": [
        "loadingspinner"
      ]
    },
    "error-alert": {
      "type": "Alert",
      "variant": "error",
      "title": "Unable to load compliance data",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "error"
        ]
      },
      "children": "An error occurred while retrieving compliance requirements. Please try again or contact your administrator if the issue persists."
    },
    "empty-vendor-text": {
      "type": "Text",
      "children": "$data.vendor.name"
    },
    "empty-vendor-item": {
      "type": "DescriptionListItem",
      "label": "Vendor",
      "children": [
        "empty-vendor-text"
      ]
    },
    "empty-domain-text": {
      "type": "Text",
      "children": "$data.vendor.domain"
    },
    "empty-domain-item": {
      "type": "DescriptionListItem",
      "label": "Domain",
      "children": [
        "empty-domain-text"
      ]
    },
    "empty-vendorid-text": {
      "type": "Text",
      "children": "$data.vendor.vendorId"
    },
    "empty-vendorid-item": {
      "type": "DescriptionListItem",
      "label": "Vendor ID",
      "children": [
        "empty-vendorid-text"
      ]
    },
    "empty-identity": {
      "type": "DescriptionList",
      "direction": "row",
      "children": [
        "empty-vendor-item",
        "empty-domain-item",
        "empty-vendorid-item"
      ]
    },
    "empty-divider": {
      "type": "Divider"
    },
    "empty-body-text": {
      "type": "Text",
      "children": "No compliance requirements have been configured for this vendor. Add requirements to begin tracking W-9 forms, insurance certificates, and other documentation."
    },
    "empty-add-button": {
      "type": "Button",
      "variant": "primary",
      "children": "Add requirements"
    },
    "emptystate": {
      "type": "EmptyState",
      "title": "No compliance requirements",
      "layout": "vertical",
      "imageName": "forms",
      "imageWidth": 120,
      "children": [
        "empty-body-text",
        "empty-add-button"
      ]
    },
    "empty-state": {
      "type": "Flex",
      "name": "empty-state",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "empty"
        ]
      },
      "children": [
        "empty-identity",
        "empty-divider",
        "emptystate"
      ]
    },
    "compliance-alert": {
      "type": "Alert",
      "name": "compliance-alert",
      "variant": "$data.alert.variant",
      "title": "$data.alert.title",
      "children": "$data.alert.body"
    },
    "compliance-progress": {
      "type": "ProgressBar",
      "name": "compliance-progress",
      "title": "Overall compliance",
      "value": "$data.compliance.score",
      "maxValue": 100,
      "showPercentage": true,
      "valueDescription": "$data.compliance.valueDescription",
      "variant": "$data.compliance.progressVariant"
    },
    "vendor-name-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "$data.vendor.name"
    },
    "vendor-name-item": {
      "type": "DescriptionListItem",
      "label": "Vendor",
      "children": [
        "vendor-name-text"
      ]
    },
    "vendor-id-text": {
      "type": "Text",
      "children": "$data.vendor.vendorId"
    },
    "vendor-id-item": {
      "type": "DescriptionListItem",
      "label": "Vendor ID",
      "children": [
        "vendor-id-text"
      ]
    },
    "contract-start-text": {
      "type": "Text",
      "children": "$data.vendor.contractStartLabel"
    },
    "contract-start-item": {
      "type": "DescriptionListItem",
      "label": "Contract start",
      "children": [
        "contract-start-text"
      ]
    },
    "primary-contact-text": {
      "type": "Text",
      "children": "$data.vendor.primaryContact"
    },
    "primary-contact-item": {
      "type": "DescriptionListItem",
      "label": "Primary contact",
      "children": [
        "primary-contact-text"
      ]
    },
    "vendor-identity": {
      "type": "DescriptionList",
      "name": "vendor-identity",
      "direction": "row",
      "children": [
        "vendor-name-item",
        "vendor-id-item",
        "contract-start-item",
        "primary-contact-item"
      ]
    },
    "divider": {
      "type": "Divider"
    },
    "requirements-header-text": {
      "type": "Text",
      "format": {
        "fontWeight": "demibold"
      },
      "children": "Requirements"
    },
    "requirements-header": {
      "type": "Flex",
      "name": "requirements-header",
      "direction": "row",
      "justify": "between",
      "align": "center",
      "children": [
        "requirements-header-text"
      ]
    },
    "requirements-table": {
      "type": "DataTable",
      "name": "requirements-table",
      "data": "$data.requirements",
      "searchFields": [
        "requirement",
        "category"
      ],
      "searchPlaceholder": "Search requirements...",
      "pageSize": 10,
      "filters": [
        {
          "type": "select",
          "name": "status",
          "placeholder": "All statuses",
          "options": "$data.statusFilterOptions"
        }
      ],
      "columns": [
        {
          "field": "requirement",
          "label": "Requirement",
          "width": "auto",
          "sortable": true,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Flex",
              "direction": "row",
              "align": "center",
              "gap": "xs",
              "children": [
                {
                  "type": "StatusTag",
                  "variant": "$row.statusTagVariant"
                },
                {
                  "type": "Link",
                  "overlay": {
                    "type": "Panel",
                    "id": "compliance-detail-{{row.id}}",
                    "title": "$row.requirement",
                    "width": "small",
                    "variant": "modal",
                    "flush": true,
                    "children": [
                      {
                        "type": "PanelBody",
                        "children": [
                          {
                            "type": "PanelSection",
                            "children": [
                              {
                                "type": "Flex",
                                "direction": "column",
                                "gap": "sm",
                                "children": [
                                  {
                                    "type": "Flex",
                                    "direction": "row",
                                    "gap": "xs",
                                    "align": "center",
                                    "children": [
                                      {
                                        "type": "StatusTag",
                                        "variant": "$row.statusTagVariant",
                                        "children": "$row.statusLabel"
                                      },
                                      {
                                        "type": "Tag",
                                        "variant": "info",
                                        "visible": "$row.recurring",
                                        "children": "$row.recurringLabel"
                                      },
                                      {
                                        "type": "Tag",
                                        "visible": {
                                          "$eq": [
                                            "$row.recurring",
                                            false
                                          ]
                                        },
                                        "children": "One-time"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionList",
                                    "direction": "column",
                                    "children": [
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Category",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.category"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Last received",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.dateReceivedLabel"
                                          }
                                        ]
                                      },
                                      {
                                        "type": "DescriptionListItem",
                                        "label": "Expiration",
                                        "children": [
                                          {
                                            "type": "Text",
                                            "children": "$row.expirationLabel"
                                          }
                                        ]
                                      }
                                    ]
                                  },
                                  {
                                    "type": "Divider"
                                  },
                                  {
                                    "type": "Text",
                                    "format": {
                                      "fontWeight": "demibold"
                                    },
                                    "children": "Update compliance status"
                                  },
                                  {
                                    "type": "Select",
                                    "label": "Status",
                                    "name": "status-{{row.id}}",
                                    "required": true,
                                    "options": "$data.statusOptions"
                                  },
                                  {
                                    "type": "DateInput",
                                    "label": "Date received",
                                    "name": "date-received-{{row.id}}",
                                    "format": "medium"
                                  },
                                  {
                                    "type": "DateInput",
                                    "label": "Expiration date",
                                    "name": "expiration-{{row.id}}",
                                    "format": "medium",
                                    "visible": "$row.recurring"
                                  },
                                  {
                                    "type": "TextArea",
                                    "label": "Notes",
                                    "name": "notes-{{row.id}}",
                                    "placeholder": "Add documentation notes, policy numbers, or file references...",
                                    "resize": "vertical",
                                    "rows": 3
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "PanelFooter",
                        "children": [
                          {
                            "type": "Flex",
                            "direction": "column",
                            "children": [
                              {
                                "type": "Flex",
                                "direction": "row",
                                "justify": "between",
                                "children": [
                                  {
                                    "type": "Button",
                                    "variant": "secondary",
                                    "onClick": {
                                      "$action": "closeOverlay",
                                      "id": "compliance-detail-{{row.id}}"
                                    },
                                    "children": "Cancel"
                                  },
                                  {
                                    "type": "LoadingButton",
                                    "variant": "primary",
                                    "children": "Save changes"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "children": {
                    "type": "Text",
                    "format": {
                      "fontWeight": "demibold"
                    },
                    "children": "$value"
                  }
                }
              ]
            }
          }
        },
        {
          "field": "category",
          "label": "Category",
          "width": "min",
          "sortable": true,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "children": "$value"
            }
          }
        },
        {
          "field": "statusLabel",
          "label": "Status",
          "width": "min",
          "sortable": true,
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Tag",
              "variant": "$row.statusVariant",
              "children": "$value"
            }
          }
        },
        {
          "field": "expirationLabel",
          "label": "Expiration",
          "width": "min",
          "sortable": true
        },
        {
          "field": "recurringLabel",
          "label": "Type",
          "width": "min",
          "sortable": false
        },
        {
          "field": "actions",
          "label": "Actions",
          "width": "min",
          "sortable": false,
          "align": "right",
          "renderCell": {
            "$render": [
              "value",
              "row"
            ],
            "node": {
              "type": "Button",
              "size": "extra-small",
              "variant": "secondary",
              "overlay": {
                "type": "Panel",
                "id": "compliance-update-{{row.id}}",
                "title": "$row.requirement",
                "width": "small",
                "variant": "modal",
                "flush": true,
                "children": [
                  {
                    "type": "PanelBody",
                    "children": [
                      {
                        "type": "PanelSection",
                        "children": [
                          {
                            "type": "Flex",
                            "direction": "column",
                            "gap": "sm",
                            "children": [
                              {
                                "type": "Flex",
                                "direction": "row",
                                "gap": "xs",
                                "align": "center",
                                "children": [
                                  {
                                    "type": "StatusTag",
                                    "variant": "$row.statusTagVariant",
                                    "children": "$row.statusLabel"
                                  },
                                  {
                                    "type": "Tag",
                                    "variant": "info",
                                    "visible": "$row.recurring",
                                    "children": "$row.recurringLabel"
                                  },
                                  {
                                    "type": "Tag",
                                    "visible": {
                                      "$eq": [
                                        "$row.recurring",
                                        false
                                      ]
                                    },
                                    "children": "One-time"
                                  }
                                ]
                              },
                              {
                                "type": "DescriptionList",
                                "direction": "column",
                                "children": [
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Category",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.category"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Last received",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.dateReceivedLabel"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "DescriptionListItem",
                                    "label": "Expiration",
                                    "children": [
                                      {
                                        "type": "Text",
                                        "children": "$row.expirationLabel"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "type": "Divider"
                              },
                              {
                                "type": "Text",
                                "format": {
                                  "fontWeight": "demibold"
                                },
                                "children": "Update compliance status"
                              },
                              {
                                "type": "Select",
                                "label": "Status",
                                "name": "status-btn-{{row.id}}",
                                "required": true,
                                "options": "$data.statusOptions"
                              },
                              {
                                "type": "DateInput",
                                "label": "Date received",
                                "name": "date-received-btn-{{row.id}}",
                                "format": "medium"
                              },
                              {
                                "type": "DateInput",
                                "label": "Expiration date",
                                "name": "expiration-btn-{{row.id}}",
                                "format": "medium",
                                "visible": "$row.recurring"
                              },
                              {
                                "type": "TextArea",
                                "label": "Notes",
                                "name": "notes-btn-{{row.id}}",
                                "placeholder": "Add documentation notes, policy numbers, or file references...",
                                "resize": "vertical",
                                "rows": 3
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "PanelFooter",
                    "children": [
                      {
                        "type": "Flex",
                        "direction": "column",
                        "children": [
                          {
                            "type": "Flex",
                            "direction": "row",
                            "justify": "between",
                            "children": [
                              {
                                "type": "Button",
                                "variant": "secondary",
                                "onClick": {
                                  "$action": "closeOverlay",
                                  "id": "compliance-update-{{row.id}}"
                                },
                                "children": "Cancel"
                              },
                              {
                                "type": "LoadingButton",
                                "variant": "primary",
                                "children": "Save changes"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "children": "Update"
            }
          }
        }
      ],
      "emptyTitle": "No matching requirements",
      "emptyMessage": "No compliance requirements match your search criteria. Try adjusting your filters."
    },
    "activity-accordion": {
      "type": "Accordion",
      "name": "activity-accordion",
      "title": "Recent compliance activity",
      "size": "sm",
      "defaultOpen": false,
      "children": [
        {
          "type": "DescriptionList",
          "direction": "column",
          "children": [
            {
              "$forEach": "$data.activity",
              "as": "entry",
              "render": {
                "type": "DescriptionListItem",
                "label": "$entry.dateLabel",
                "children": [
                  {
                    "type": "Flex",
                    "direction": "row",
                    "align": "center",
                    "gap": "xs",
                    "children": [
                      {
                        "type": "Icon",
                        "name": "$entry.icon"
                      },
                      {
                        "type": "Text",
                        "children": "$entry.text"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "loaded-content": {
      "type": "Flex",
      "name": "loaded-content",
      "direction": "column",
      "gap": "sm",
      "visible": {
        "$eq": [
          "$state.viewMode",
          "loaded"
        ]
      },
